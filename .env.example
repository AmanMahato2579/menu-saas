# =============================================================================
# Local Development
# =============================================================================
# For local dev, `docker compose up -d` starts Postgres on localhost:5432.
# Copy this file to `.env` and fill in the values.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/menu_saas
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/menu_saas

# Random secret used by NextAuth to sign session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# The public URL of the app (no trailing slash). Used for QR code links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Push notification (VAPID) keys — generate once with:
#   npx web-push generate-vapid-keys
# Never regenerate these later; it invalidates every device that already
# enabled notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com


# =============================================================================
# Vercel Deployment (Environment Variables)
# =============================================================================
# Set these in Vercel Dashboard → Project → Settings → Environment Variables.
# Vercel auto-deploys `main` → Production, `dev` → Development (Preview).
#
# Branch-scoped variables:
#   - Production (main branch):
#       DATABASE_URL       → Production Supabase pooler URL
#       DIRECT_URL         → Production Supabase direct URL
#       AUTH_SECRET        → Production auth secret
#       NEXT_PUBLIC_APP_URL → https://your-prod-domain.vercel.app
#       NEXT_PUBLIC_VAPID_PUBLIC_KEY → Production VAPID key
#       VAPID_PRIVATE_KEY  → Production VAPID private key
#       VAPID_SUBJECT      → mailto:admin@yourdomain.com
#
#   - Development (dev branch):
#       DATABASE_URL       → Dev Supabase pooler URL (or same as prod for testing)
#       DIRECT_URL         → Dev Supabase direct URL (or same as prod for testing)
#       AUTH_SECRET        → Separate dev auth secret (recommended)
#       NEXT_PUBLIC_APP_URL → Auto-set by Vercel per preview deployment
#       NEXT_PUBLIC_VAPID_PUBLIC_KEY → Same as prod (or separate dev key)
#       VAPID_PRIVATE_KEY  → Same as prod (or separate dev key)
#       VAPID_SUBJECT      → mailto:admin@yourdomain.com
#
#   - Shared across all environments:
#       AUTH_URL            → Not needed (trustHost: true handles this)
#       NODE_ENV            → Set automatically by Vercel
#
# NOTE: Never commit real secrets. Use Vercel's env var UI or `vercel env add`.
